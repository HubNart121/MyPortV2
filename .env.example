# Supabase/PostgreSQL fallback for local Docker development only
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3021
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVER_URL=http://gateway:8080

# Firebase web app configuration
# Copy these values from Firebase Console > Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Comma-separated Firebase accounts allowed to use the app
NEXT_PUBLIC_ALLOWED_GOOGLE_EMAIL=sl@brt.co.th,asiametalnart@gmail.com,iphonenart@gmail.com

# Server-side authorization
ALLOWED_GOOGLE_EMAIL=
APP_ORIGIN=http://localhost:3000

# Firebase Admin uses Application Default Credentials on App Hosting.
FIREBASE_PROJECT_ID=myport-v2
# Local-only alternative. Keep this value secret and never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Distributed backup API rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BACKUP_RATE_LIMIT_REQUESTS=10
BACKUP_RATE_LIMIT_WINDOW_SECONDS=60
# Only set this after confirming the exact reverse-proxy chain.
TRUSTED_PROXY_HOPS=0
