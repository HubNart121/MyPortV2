# Server-side authorization
ALLOWED_GOOGLE_EMAIL=

# Exact application origin used for Restore origin checks
APP_ORIGIN=http://localhost:3000

# Firebase Admin
FIREBASE_PROJECT_ID=myport-v2
# Optional for local development when ADC is unavailable.
# Never commit a populated service-account JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase browser configuration (non-secret public config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ALLOWED_GOOGLE_EMAIL=sl@brt.co.th,asiametalnart@gmail.com,iphonenart@gmail.com

# Distributed rate limiting — required in production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BACKUP_RATE_LIMIT_REQUESTS=10
BACKUP_RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_HOPS=0

# Optional local PostgreSQL fallback
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3021
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVER_URL=http://gateway:8080
